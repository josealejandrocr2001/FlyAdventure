# Copie este archivo como .env (NO suba el .env a GitHub).
# Cada integrante usa su propio MySQL local.

PORT=4000

# MySQL local (MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=su_contrasena_de_mysql
DB_NAME=flyadventure

# Seguridad: cadena larga y aleatoria. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Origen del frontend (Vite) al que se le permiten peticiones
CORS_ORIGIN=http://localhost:5173
