# Copie este archivo como .env.local (Vite lo lee; NO se sube a GitHub).

# URL de la API (carpeta /server). En local:
VITE_API_URL=http://localhost:4000/api

# URL pública del sitio, para armar el enlace de la encuesta en los correos
VITE_SITE_URL=http://localhost:5173

# EmailJS (pídale los valores a Jose; no los escriba en el código)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_CONFIRMACION=
VITE_EMAILJS_TEMPLATE_ENCUESTA=
